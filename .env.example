# AI-Based Verification of Quantum Experiment Proposals
# Copy this file to .env and configure your credentials.
# If no credentials are provided, the application runs in explicitly-labelled DEMO MODE.

# Google Cloud Vertex AI Configuration (Primary Provider via Service Account ADC)
LLM_PROVIDER=vertex
GOOGLE_APPLICATION_CREDENTIALS=C:\GoogleCloudCredentials\vertex-service-account.json
VERTEX_PROJECT_ID=acquired-winter-511114-c2
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash

# Google Gemini Configuration (Google AI Studio Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Vector Store / Embedding settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./chroma_db
